# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

default_platform(:ios)

platform :ios do
  desc "Build Lift Tracker and upload to App Store Connect"
  lane :release do
    build_app(
      workspace: "../LetsHang.xcworkspace",
      scheme: "Lift Tracker",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "LiftTracker.ipa"
    )
    upload_to_app_store(
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      force: true
    )
  end

  desc "Upload an already-built IPA to TestFlight / App Store Connect"
  lane :upload do
    upload_to_app_store(
      ipa: "./build/LiftTracker.ipa",
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      force: true
    )
  end
end
