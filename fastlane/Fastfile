# Prefer: ~/.gem/ruby/4.0.0/bin/fastlane ios release

ENV["LC_ALL"] = "en_US.UTF-8"
ENV["LANG"] = "en_US.UTF-8"

APP_ID = "letshang.Lift-Tracker"
IPA_NAME = "LiftTracker.ipa"
WORKSPACE = "../LetsHang.xcworkspace"
SCHEME = "Lift Tracker"

def resolve_asc_key_path(raw_path)
  fastlane_dir = File.expand_path(__dir__)
  candidates = [
    File.expand_path(raw_path, fastlane_dir),
    File.expand_path(raw_path),
    File.expand_path(raw_path, File.expand_path("../..", __dir__))
  ]
  path = candidates.find { |p| File.file?(p) }
  UI.user_error!("APP_STORE_CONNECT_KEY_PATH file not found: #{raw_path}") unless path
  path
end

def upload_ipa_via_altool(ipa_path)
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
  raw_path = ENV["APP_STORE_CONNECT_KEY_PATH"].to_s.strip
  UI.user_error!("Set APP_STORE_CONNECT_* in fastlane/.env") if key_id.empty? || issuer_id.empty? || raw_path.empty?

  key_path = resolve_asc_key_path(raw_path)
  keys_dir = File.dirname(key_path)
  UI.user_error!("IPA not found: #{ipa_path}") unless File.file?(ipa_path)

  require "shellwords"
  sh(
    "export API_PRIVATE_KEYS_DIR=#{Shellwords.escape(keys_dir)} LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 && " \
    "xcrun altool --upload-app -f #{Shellwords.escape(ipa_path)} --type ios " \
    "--api-key #{Shellwords.escape(key_id)} --api-issuer #{Shellwords.escape(issuer_id)}"
  )
end

def project_version_and_build
  pbx = File.expand_path("../Lift Tracker.xcodeproj/project.pbxproj", __dir__)
  contents = File.read(pbx)
  version = contents[/MARKETING_VERSION = ([^;]+);/, 1]&.strip
  build = contents[/CURRENT_PROJECT_VERSION = ([^;]+);/, 1]&.strip
  UI.user_error!("Could not read version/build") if version.to_s.empty? || build.to_s.empty?
  [version, build]
end

def asc_api_key_hash
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
  raw_path = ENV["APP_STORE_CONNECT_KEY_PATH"].to_s.strip
  UI.user_error!("Set APP_STORE_CONNECT_* in fastlane/.env") if key_id.empty? || issuer_id.empty? || raw_path.empty?
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: resolve_asc_key_path(raw_path),
    in_house: false
  )
end

default_platform(:ios)

platform :ios do
  desc "Build and upload Lift Tracker IPA (does NOT submit for review)"
  lane :release do
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: IPA_NAME,
      xcodebuild_formatter: "",
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates"
    )
    ipa = File.expand_path("./build/#{IPA_NAME}", File.expand_path("..", __dir__))
    upload_ipa_via_altool(ipa)
    UI.success("✅ Lift Tracker uploaded to App Store Connect (not submitted for review).")
  end

  desc "Submit current version/build for App Store review"
  lane :submit do |options|
    api_key_hash = asc_api_key_hash
    version, build = project_version_and_build
    whats_new = options[:whats_new] || <<~NOTES.strip
      Fixes home screen ads so they appear on Exercises without switching tabs, and enables Firebase Analytics.
    NOTES

    key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
    key_path = resolve_asc_key_path(ENV["APP_STORE_CONNECT_KEY_PATH"].to_s.strip)
    token = Spaceship::ConnectAPI::Token.create(key_id: key_id, issuer_id: issuer_id, filepath: key_path)
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App not found") unless app

    store_version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No editable App Store version") unless store_version
    if store_version.version_string != version
      store_version.update(attributes: { versionString: version })
      store_version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    end

    localizations = store_version.get_app_store_version_localizations
    en = localizations.find { |l| l.locale == "en-US" } || localizations.first
    en.update(attributes: { whatsNew: whats_new }) if en

    if (app_info = app.fetch_edit_app_info) && (age = app_info.fetch_age_rating_declaration)
      age.update(attributes: {
        advertising: true,
        healthOrWellnessTopics: true,
        userGeneratedContent: false,
        gunsOrOtherWeapons: Spaceship::ConnectAPI::AgeRatingDeclaration::Rating::NONE,
        messagingAndChat: false,
        ageAssurance: false,
        parentalControls: false,
        lootBox: false
      })
    end

    deliver(
      api_key: api_key_hash,
      app_identifier: APP_ID,
      app_version: version,
      build_number: build,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: false,
      phased_release: true,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: true
      }
    )
    UI.success("✅ Lift Tracker #{version} (#{build}) submitted for App Store review.")
  end
end
